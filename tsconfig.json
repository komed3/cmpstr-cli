{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": [ "node" ],
    "declaration": false,
    "sourceMap": false,
    "removeComments": true,
    "esModuleInterop": true,
    "strict": true,
    "rootDir": "./src",
    "outDir": "./dist"
  },
  "include": [ "src" ]
}
